# Copie este arquivo para ".env" e ajuste. Todas as variáveis são opcionais.

# Porta e endereço de escuta
PORT=3000
HOST=0.0.0.0

# Endereço público do site (usado em canonical, sitemap, Open Graph e dados estruturados).
# Em produção, defina o domínio final com https. Também pode ser configurado em Painel > Site e SEO.
# SITE_URL=https://www.seusite.com.br

# Atrás de proxy/CDN (Nginx, Cloudflare...): 1 = confia no primeiro proxy (para IP real e cookies seguros)
# TRUST_PROXY=1
# Força o atributo Secure no cookie de sessão do painel (use com HTTPS)
# COOKIE_SECURE=1
NODE_ENV=development

# Primeiro acesso ao painel: se não definir, o sistema gera uma senha aleatória e a grava em
# data/CREDENCIAIS-INICIAIS-ADMIN.txt (e exige troca no primeiro login).
# ADMIN_USER=admin
# ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# Limites de upload no painel
MAX_ROM_MB=700
SESSION_HOURS=8

# Pasta dos dados JSON (padrão: ./data)
# DATA_DIR=./data

# Caminho do Chrome/Edge usado por "npm run og" e pelos testes (detecta sozinho no Windows)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Hosts externos de ROM (GoFile, R2...) liberados no player, separados por espaço
# ROM_HOSTS=https://*.gofile.io
